{
  // Nur Typprüfung: Scripting übersetzt TypeScript/TSX selbst auf dem iPhone.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Keine automatisch geladenen @types: Scripting hat weder DOM noch Node.
    "types": []
  },
  "include": ["Wetter/**/*", "test/**/*", "types/**/*.d.ts", "vitest.config.ts"]
}
